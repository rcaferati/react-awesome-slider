{
  "name": "@rcaferati/react-awesome-slider",
  "version": "5.0.0",
  "description": "React Awesome Slider is a 60fps performant, extendable, highly customisable, production ready React Component that renders a media (image/video) gallery slider carousel.",
  "author": "Rafael Caferati",
  "license": "MIT",
  "homepage": "https://github.com/rcaferati/react-awesome-slider",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcaferati/react-awesome-slider"
  },
  "bugs": {
    "url": "https://github.com/rcaferati/react-awesome-slider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.mjs",
      "require": "./dist/styles.js",
      "default": "./dist/styles.mjs"
    },
    "./autoplay": {
      "types": "./dist/autoplay.d.ts",
      "import": "./dist/autoplay.mjs",
      "require": "./dist/autoplay.js",
      "default": "./dist/autoplay.mjs"
    },
    "./captioned": {
      "types": "./dist/captioned.d.ts",
      "import": "./dist/captioned.mjs",
      "require": "./dist/captioned.js",
      "default": "./dist/captioned.mjs"
    },
    "./lettering": {
      "types": "./dist/lettering.d.ts",
      "import": "./dist/lettering.mjs",
      "require": "./dist/lettering.js",
      "default": "./dist/lettering.mjs"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.mjs",
      "require": "./dist/navigation.js",
      "default": "./dist/navigation.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./captioned.css": "./dist/captioned.css",
    "./lettering.css": "./dist/lettering.css",
    "./custom-animations/*": "./dist/custom-animations/*.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "styles": [
        "dist/styles.d.ts"
      ],
      "autoplay": [
        "dist/autoplay.d.ts"
      ],
      "captioned": [
        "dist/captioned.d.ts"
      ],
      "lettering": [
        "dist/lettering.d.ts"
      ],
      "navigation": [
        "dist/navigation.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:js && npm run build:css && npm run build:animations",
    "build:js": "tsup",
    "build:css": "sass --no-source-map --silence-deprecation=import src/core/styles.scss dist/styles.css && sass --no-source-map --silence-deprecation=import src/hoc/animated-lettering/styles.scss dist/lettering.css && sass --no-source-map --silence-deprecation=import src/hoc/captioned-images/styles.scss dist/captioned.css",
    "build:animations": "node scripts/build-animations.mjs",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@rcaferati/wac": "^1.2.0",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@rcaferati/react-awesome-button": "^8.0.0",
    "@storybook/addon-a11y": "^10.2.14",
    "@storybook/addon-docs": "^10.2.14",
    "@storybook/addon-styling-webpack": "^3.0.0",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/react-webpack5": "^10.2.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.21",
    "css-loader": "^6.11.0",
    "eslint-plugin-storybook": "^10.2.14",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "postcss-loader": "^7.3.4",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "rimraf": "^6.0.1",
    "sass": "^1.97.3",
    "sass-loader": "^13.3.3",
    "storybook": "^10.2.14",
    "style-loader": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "volta": {
    "node": "24.14.0"
  }
}
